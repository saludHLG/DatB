# Configuración de Supabase para el build de GitHub Pages.
# IMPORTANTE: PostgREST de este proyecto RECHAZA las claves `sb_publishable_`
# con HTTP 401. Debe usarse la anon key en formato JWT (empieza por "eyJhbGciOi").
#
# En producción, definir VITE_SUPABASE_ANON_KEY como Repository Secret
# (Settings → Secrets and variables → Actions) y referenciarla en
# .github/workflows/deploy-pages.yml.
#
# En local: copiar este archivo a `.env` (SIN BOM) y completar el valor.

VITE_SUPABASE_URL=https://arbdhyeycvyskjgpjlmn.supabase.co
VITE_SUPABASE_ANON_KEY=
